# Server Port
PORT=5000

# Security & Admin Authentication
ADMIN_JWT_SECRET=your_jwt_secret_key_here

# Supabase Cloud Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# SMTP / Email Inquiry Notifications (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM_NAME=AarviCloud
MAIL_FROM_ADDRESS=noreply@aarvicloud.com
CONTACT_NOTIFICATION_EMAIL=info@aarvicloud.com
